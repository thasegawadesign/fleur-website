{
  "name": "fleur-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.1",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:css": "stylelint \"**/*.{css,scss,sass}\"",
    "lint:css:fix": "stylelint --fix \"**/*.{css,scss,sass}\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format:check && pnpm run lint && pnpm run lint:css && pnpm run typecheck",
    "prepare": "lefthook install --reset-hooks-path"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.4",
    "@react-hook/window-size": "^3.1.1",
    "@vanilla-extract/css": "^1.21.2",
    "@vercel/analytics": "^1.6.1",
    "clsx": "^2.1.1",
    "jotai": "^2.20.3",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "yakuhanjp": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "lefthook": "^2.1.12",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.81.0",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^14.0.1",
    "stylelint-order": "^6.0.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^24.13.0"
  }
}
